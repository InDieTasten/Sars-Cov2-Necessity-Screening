# PR preview only: builds the Angular app in app/ from this branch and serves it with the production nginx config.
# The published image (Dockerfile) still serves the frozen site from gh-pages - see .github/workflows/preview.yml.
FROM node:22.23.5-alpine AS build
WORKDIR /build
ENV NG_CLI_ANALYTICS=false
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
RUN npx ng build --configuration production

FROM nginxinc/nginx-unprivileged:1.31.7-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/app/ /usr/share/nginx/html/
